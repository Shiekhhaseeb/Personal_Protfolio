# Copy this file to .env and fill in your values locally.
# NEVER commit .env to Git. NEVER paste real keys in chat or markdown files.

# Which LLM powers the portfolio chatbot: groq | gemini
LLM_PROVIDER=groq

# Use ONE of the following (match LLM_PROVIDER above)
GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_gemini_key_here
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.0-flash

# App
ENV=development
CHAT_RATE_LIMIT=20
